diff --git a/src/renderer/FrameCapture.zig b/src/renderer/FrameCapture.zig
new file mode 100644
--- /dev/null
+++ b/src/renderer/FrameCapture.zig
@@ -0,0 +1,190 @@
+//! Bounded owned terminal frame handoff. No GPU/IOSurface pointer escapes.
+const FrameCapture = @This();
+
+const std = @import("std");
+
+pub const maximum_bytes = 32 * 1024 * 1024;
+pub const maximum_dimension = 8192;
+
+/// C ABI: ghostty_frame_s. Pixels are tightly packed, premultiplied BGRA8
+/// in Display P3. A successful read transfers ownership to the caller.
+pub const Frame = extern struct {
+    request_id: u64 = 0,
+    width: u32 = 0,
+    height: u32 = 0,
+    bytes_per_row: u32 = 0,
+    pixels: ?[*]u8 = null,
+    pixels_len: usize = 0,
+
+    pub fn deinit(self: *Frame, alloc: std.mem.Allocator) void {
+        if (self.pixels) |pixels| alloc.free(pixels[0..self.pixels_len]);
+        self.* = .{};
+    }
+};
+
+allocator: std.mem.Allocator = std.heap.c_allocator,
+mutex: std.Io.Mutex = .init,
+highest_request: u64 = 0,
+request_id: u64 = 0,
+phase: enum { idle, pending, ready, failed } = .idle,
+frame: Frame = .{},
+
+/// Strictly increasing IDs prevent an abandoned queued request from being
+/// mistaken for a later request after cancellation. At most one is retained.
+pub fn begin(self: *FrameCapture, io: std.Io, request_id: u64) bool {
+    self.mutex.lockUncancelable(io);
+    defer self.mutex.unlock(io);
+    if (self.phase != .idle or request_id == 0 or request_id <= self.highest_request) return false;
+    self.highest_request = request_id;
+    self.request_id = request_id;
+    self.phase = .pending;
+    return true;
+}
+
+pub fn pending(self: *FrameCapture, io: std.Io, request_id: u64) bool {
+    self.mutex.lockUncancelable(io);
+    defer self.mutex.unlock(io);
+    return self.phase == .pending and self.request_id == request_id;
+}
+
+pub fn fail(self: *FrameCapture, io: std.Io, request_id: u64) void {
+    self.mutex.lockUncancelable(io);
+    defer self.mutex.unlock(io);
+    if (self.phase == .pending and self.request_id == request_id) self.phase = .failed;
+}
+
+/// Must be called after GPU completion and before recycling its target. Copy
+/// rows while the target is still owned by that frame, never retain its pointer.
+pub fn complete(self: *FrameCapture, io: std.Io, request_id: u64, width: usize, height: usize, source_stride: usize, source: []const u8) void {
+    self.mutex.lockUncancelable(io);
+    defer self.mutex.unlock(io);
+    if (self.phase != .pending or self.request_id != request_id) return;
+    self.phase = .failed;
+    if (width == 0 or height == 0 or width > maximum_dimension or height > maximum_dimension) return;
+    const stride = width * 4;
+    const len = stride * height;
+    if (len > maximum_bytes or source_stride < stride) return;
+    const last_row = std.math.mul(usize, source_stride, height - 1) catch return;
+    const required = std.math.add(usize, last_row, stride) catch return;
+    if (source.len < required) return;
+    const pixels = self.allocator.alloc(u8, len) catch return;
+    for (0..height) |row| @memcpy(pixels[row * stride ..][0..stride], source[row * source_stride ..][0..stride]);
+    self.frame = .{
+        .request_id = request_id,
+        .width = @intCast(width),
+        .height = @intCast(height),
+        .bytes_per_row = @intCast(stride),
+        .pixels = pixels.ptr,
+        .pixels_len = pixels.len,
+    };
+    self.phase = .ready;
+}
+
+/// 0 pending, 1 ready with ownership transferred, -1 failed/unknown.
+pub fn read(self: *FrameCapture, io: std.Io, request_id: u64, result: *Frame) c_int {
+    result.* = .{};
+    self.mutex.lockUncancelable(io);
+    defer self.mutex.unlock(io);
+    if (self.request_id != request_id or self.phase == .idle) return -1;
+    switch (self.phase) {
+        .pending => return 0,
+        .ready => {
+            result.* = self.frame;
+            self.frame = .{};
+            self.phase = .idle;
+            self.request_id = 0;
+            return 1;
+        },
+        .failed => {
+            self.phase = .idle;
+            self.request_id = 0;
+            return -1;
+        },
+        .idle => unreachable,
+    }
+}
+
+pub fn cancel(self: *FrameCapture, io: std.Io, request_id: u64) void {
+    self.mutex.lockUncancelable(io);
+    defer self.mutex.unlock(io);
+    if (self.request_id != request_id) return;
+    self.frame.deinit(self.allocator);
+    self.phase = .idle;
+    self.request_id = 0;
+}
+
+pub fn deinit(self: *FrameCapture, io: std.Io) void {
+    self.mutex.lockUncancelable(io);
+    defer self.mutex.unlock(io);
+    self.frame.deinit(self.allocator);
+    self.phase = .idle;
+    self.request_id = 0;
+}
+
+test "capture owns pixels, strips row padding and transfers once" {
+    const t = std.testing;
+    var capture: FrameCapture = .{ .allocator = t.allocator };
+    defer capture.deinit(t.io);
+    var source = [_]u8{ 1, 2, 3, 4, 99, 99, 99, 99, 5, 6, 7, 8 };
+    try t.expect(capture.begin(t.io, 1));
+    var frame: Frame = .{};
+    try t.expectEqual(@as(c_int, 0), capture.read(t.io, 1, &frame));
+    capture.complete(t.io, 1, 1, 2, 8, &source);
+    @memset(&source, 0);
+    try t.expectEqual(@as(c_int, 1), capture.read(t.io, 1, &frame));
+    defer frame.deinit(t.allocator);
+    try t.expectEqual(@as(u32, 4), frame.bytes_per_row);
+    try t.expectEqualSlices(u8, &.{ 1, 2, 3, 4, 5, 6, 7, 8 }, frame.pixels.?[0..frame.pixels_len]);
+    var missing: Frame = .{};
+    try t.expectEqual(@as(c_int, -1), capture.read(t.io, 1, &missing));
+}
+
+test "cancelled queued and failed captures cannot complete a successor" {
+    const t = std.testing;
+    var capture: FrameCapture = .{ .allocator = t.allocator };
+    defer capture.deinit(t.io);
+    try t.expect(!capture.begin(t.io, 0));
+    try t.expect(capture.begin(t.io, 1));
+    try t.expect(!capture.begin(t.io, 2));
+    capture.cancel(t.io, 1);
+    try t.expect(!capture.begin(t.io, 1));
+    try t.expect(capture.begin(t.io, 2));
+    capture.complete(t.io, 1, 1, 1, 4, &.{ 1, 2, 3, 4 });
+    capture.fail(t.io, 1);
+    capture.cancel(t.io, 1);
+    try t.expect(capture.pending(t.io, 2));
+    var frame: Frame = .{};
+    try t.expectEqual(@as(c_int, -1), capture.read(t.io, 1, &frame));
+    try t.expect(capture.pending(t.io, 2));
+    capture.fail(t.io, 2);
+    try t.expectEqual(@as(c_int, -1), capture.read(t.io, 2, &frame));
+    try t.expect(capture.begin(t.io, 3));
+}
+
+test "malformed and over-bound frames fail without retaining allocations" {
+    const t = std.testing;
+    var capture: FrameCapture = .{ .allocator = t.allocator };
+    defer capture.deinit(t.io);
+    const cases = [_][3]usize{
+        .{ 0, 1, 4 },                                                     .{ maximum_dimension + 1, 1, 4 },
+        .{ maximum_dimension, maximum_dimension, maximum_dimension * 4 }, .{ 1, 1, 3 },
+        .{ 1, 2, std.math.maxInt(usize) },                                .{ 1, 2, 4 },
+    };
+    for (cases, 1..) |c, request| {
+        try t.expect(capture.begin(t.io, request));
+        capture.complete(t.io, request, c[0], c[1], c[2], &.{ 1, 2, 3, 4 });
+        var frame: Frame = .{};
+        try t.expectEqual(@as(c_int, -1), capture.read(t.io, request, &frame));
+        try t.expect(frame.pixels == null);
+    }
+}
+
+test "ready capture cancellation frees retained pixels" {
+    const t = std.testing;
+    var capture: FrameCapture = .{ .allocator = t.allocator };
+    defer capture.deinit(t.io);
+    try t.expect(capture.begin(t.io, 1));
+    capture.complete(t.io, 1, 1, 1, 4, &.{ 1, 2, 3, 4 });
+    capture.cancel(t.io, 1);
+    try t.expect(capture.begin(t.io, 2));
+}
