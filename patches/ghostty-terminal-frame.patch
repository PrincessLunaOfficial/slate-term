+    /// Request an owned GPU-completed terminal frame. The public host must
+    /// bound its wait and cancel abandoned requests. Never touches the PTY.
+    export fn ghostty_surface_request_frame(surface: *Surface, request_id: u64) bool {
+        if (comptime !@hasDecl(renderer.Renderer.API, "captureSupported")) return false;
+        const capture = &surface.core_surface.renderer.frame_capture;
+        if (!capture.begin(global.io(), request_id)) return false;
+        const thread = &surface.core_surface.renderer_thread;
+        if (thread.mailbox.push(global.io(), .{ .capture_frame = request_id }, .instant) == 0) {
+            capture.cancel(global.io(), request_id);
+            return false;
+        }
+        thread.wakeup.notify() catch {
+            capture.cancel(global.io(), request_id);
+            return false;
+        };
+        return true;
+    }
+
+    export fn ghostty_surface_read_frame(surface: *Surface, request_id: u64, result: *@import("../renderer/FrameCapture.zig").Frame) c_int {
+        return surface.core_surface.renderer.frame_capture.read(global.io(), request_id, result);
+    }
+
+    export fn ghostty_surface_cancel_frame(surface: *Surface, request_id: u64) void {
+        surface.core_surface.renderer.frame_capture.cancel(global.io(), request_id);
+    }
+
+    export fn ghostty_surface_free_frame(frame: *@import("../renderer/FrameCapture.zig").Frame) void {
+        frame.deinit(std.heap.c_allocator);
+    }
